        "//code/chatbot/controller",
        "//code/chatbot/handler",
        "//code/chatbot/store",
        "//gen/idl/chatbot",
        "//pkg/configloader",
        "//pkg/grpcserver",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@org_golang_google_grpc//:grpc",
        "@org_uber_go_fx//:fx",
