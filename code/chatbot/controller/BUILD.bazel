load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "controller",
    srcs = ["chat.go"],
    importpath = "github.com/PriyanshuTrivedi/nexus-scheduler/code/chatbot/controller",
    visibility = ["//visibility:public"],
    deps = [
        "//code/chatbot/chunker",
        "//code/chatbot/client",
        "//code/chatbot/entity",
        "//code/chatbot/prompt",
        "//code/chatbot/store",
        "//code/chatbot/util",
        "@org_golang_google_genai//:genai",
    ],
)

go_test(
    name = "controller_test",
    srcs = ["chat_test.go"],
    embed = [":controller"],
    deps = [
        "//code/chatbot/entity",
        "//code/chatbot/store",
        "//gen/mocks/chatbot/chunker",
        "//gen/mocks/chatbot/client",
        "//gen/mocks/chatbot/store",
        "@com_github_golang_mock//gomock",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_google_genai//:genai",
    ],
)
