load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "handler",
    srcs = ["chat.go"],
    importpath = "github.com/PriyanshuTrivedi/nexus-scheduler/code/chatbot/handler",
    visibility = ["//visibility:public"],
    deps = [
        "//code/chatbot/controller",
        "//code/chatbot/util",
        "//gen/idl/chatbot",
    ],
)

go_test(
    name = "handler_test",
    srcs = ["chat_test.go"],
    embed = [":handler"],
    deps = [
        "//code/chatbot/entity",
        "//gen/idl/chatbot",
        "//gen/mocks/chatbot/controller",
        "@com_github_golang_mock//gomock",
        "@com_github_stretchr_testify//assert",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)
