load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "util",
    srcs = [
        "error.go",
        "http.go",
        "object_storage.go",
        "otp.go",
        "password.go",
        "token.go",
        "user.go",
    ],
    importpath = "github.com/PriyanshuTrivedi/nexus-scheduler/code/identity/util",
    visibility = ["//visibility:public"],
