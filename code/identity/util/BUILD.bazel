go_test(
    name = "util_test",
    srcs = [
        "object_storage_test.go",
        "otp_test.go",
        "password_test.go",
        "token_test.go",
    ],
    embed = [":util"],
    deps = [
        "//code/identity/entity",
        "//gen/idl/identity",
        "@com_github_stretchr_testify//require",
    ],
