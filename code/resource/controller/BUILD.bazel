load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "controller",
    srcs = ["resource.go"],
    importpath = "github.com/PriyanshuTrivedi/nexus-scheduler/code/resource/controller",
    visibility = ["//visibility:public"],
    deps = [
        "//code/resource/client",
        "//code/resource/entity",
        "//code/resource/store",
