go_test(
    name = "controller_test",
    srcs = ["resource_test.go"],
    embed = [":controller"],
    deps = [
        "//code/resource/entity",
        "//gen/mocks/resource/client",
        "//gen/mocks/resource/store",
        "@com_github_golang_mock//gomock",
        "@com_github_stretchr_testify//assert",
    ],
)
